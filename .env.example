# Copy the values you need into the ignored repository-root .env.
# Never commit real credentials. astro.config.mjs loads .env for local development.
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# Generate each separately with: openssl rand -hex 32
COURSE_DOWNLOAD_SECRET=
ANALYTICS_ID_SECRET=

# Public project token, not a PostHog personal API key. Leave blank to disable.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Optional private weekly growth collection (never expose these to the client)
GOOGLE_SEARCH_CONSOLE_ACCESS_TOKEN=
GOOGLE_SEARCH_CONSOLE_SITE_URL=sc-domain:futureofdev.com
