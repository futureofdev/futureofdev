{
  "name": "futureofdev",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "prettier": "^3.4.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "overrides": {
      "rollup": "4.59.0",
      "wrangler": "4.59.1",
      "minimatch@3": "3.1.3",
      "minimatch@9.0.5": "9.0.7",
      "prismjs": "1.30.0",
      "devalue": "5.6.3",
      "undici@7": "7.18.2",
      "ajv@6": "6.14.0"
    }
  }
}
