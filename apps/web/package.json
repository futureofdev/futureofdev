{
  "name": "@futureofdev/web",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "tsx --test src/lib/*.test.ts",
    "check:seo": "node --import tsx scripts/check-seo-rendered.ts",
    "check:local": "node --import tsx scripts/check-local-site.ts",
    "check:beehiiv": "node --import tsx scripts/check-beehiiv.ts",
    "validate:course": "tsx scripts/validate-course.ts",
    "growth:collect": "tsx scripts/collect-growth-review.ts",
    "growth:review": "tsx scripts/render-growth-review.ts",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "type-check": "astro check && tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.0.0",
    "astro": "^5.1.0",
    "dotenv": "^17.2.3",
    "fflate": "^0.4.8",
    "posthog-js": "^1.353.0",
    "sanitize-html": "^2.16.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@futureofdev/eslint-config": "workspace:*",
    "@futureofdev/typescript-config": "workspace:*",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0"
  }
}
