---
import { canonicalUrl, serializeJsonLd, ORGANIZATION_ID, SITE_ORIGIN } from "../lib/seo";
import CookieConsent from "../components/CookieConsent.astro";
import PosthogAnalytics from "../components/PosthogAnalytics.astro";
import { siteNavigation } from "../content/site";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  publishedAt?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title = "Learn and build the AI-native way",
  description = "A practical AI newsletter for people in digital work. Learn useful methods, try an exercise and check the results.",
  canonicalPath = Astro.url.pathname,
  ogImage = "/og-default.png",
  ogType = "website",
  publishedAt,
  noindex = false,
  structuredData,
} = Astro.props;

const canonicalURL = canonicalUrl(canonicalPath);
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isCurrent = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath === href || currentPath.startsWith(`${href}/`);
const ogImageURL = new URL(ogImage, Astro.site);
const fullTitle = title === "Future of Dev" ? title : `${title} | Future of Dev`;
const organisation = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": ORGANIZATION_ID,
  name: "Future of Dev",
  url: "https://futureofdev.com",
  logo: "https://futureofdev.com/brand/fod-symbol.svg",
  description:
    "A newsletter-led learning brand helping people understand change, develop useful skills and build real things in the AI-native era.",
  sameAs: [
    "https://x.com/futureofdev",
    "https://www.linkedin.com/company/futureofdev",
  ],
};
const website = { "@context": "https://schema.org", "@type": "WebSite", "@id": `${SITE_ORIGIN}/#website`, name: "Future of Dev", url: SITE_ORIGIN, publisher: { "@id": ORGANIZATION_ID } };
const jsonLd = structuredData
  ? Array.isArray(structuredData)
    ? [organisation, website, ...structuredData]
    : [organisation, website, structuredData]
  : [organisation, website];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#111827" />
    <meta name="color-scheme" content="light" />
    <link rel="preload" href="/fonts/archivo.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter.woff2" as="font" type="font/woff2" crossorigin />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="alternate" type="application/rss+xml" title="Future of Dev Insights" href="/rss.xml" />
    <link rel="canonical" href={canonicalURL} />
    <title>{fullTitle}</title>

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Future of Dev" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script is:inline type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand-link" href="/" aria-label="Future of Dev home">
          <img src="/brand/fod-lockup-horizontal.svg" width="213" height="32" alt="Future of Dev" />
        </a>
        <nav class="site-nav" aria-label="Primary navigation">
          {siteNavigation.filter((item) => item.href !== "/").map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>
          ))}
        </nav>
        <a class="nav-join" href="/#join" data-analytics-cta="join" data-analytics-placement="navigation">Join</a>
      </div>
    </header>

    <main id="content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <img src="/brand/fod-lockup-horizontal-mono-white.svg" width="213" height="32" alt="Future of Dev" />
          <p>Learn and build the AI-native way.</p>
        </div>
        <nav aria-label="Footer navigation">
          {siteNavigation.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
          <a href="/privacy">Privacy</a>
          <a href="/rss.xml">RSS</a>
        </nav>
        <div class="footer-meta">
          <a href="https://x.com/futureofdev" rel="me noopener noreferrer">X</a>
          <a href="https://www.linkedin.com/company/futureofdev" rel="noopener noreferrer">LinkedIn</a>
          <p>&copy; {new Date().getFullYear()} Future of Dev.</p>
        </div>
      </div>
    </footer>

    <CookieConsent />
    <PosthogAnalytics />
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
