---
export const prerender = false;

import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
import StageTag from "../components/StageTag.astro";
import { editionEmptyState, homepageCopy } from "../content/site";
import { courseHours, courseStats } from "../lib/course-content";
import { listPublishedInsights } from "../lib/insights";
import { formatEditionDate, splitTags } from "../lib/tags";

const editions = await listPublishedInsights(Astro.locals, 4);
const latest = editions[0];
const previous = editions.slice(1);
const latestTags = splitTags(latest?.tags);

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=300, stale-while-revalidate=86400, stale-if-error=604800",
);

const date = latest && formatEditionDate(latest.publishedAt);
const courseEntry = (await getCollection("courses")).find(
  (course) => course.data.slug === "coding-bootcamp-in-a-box",
);
if (!courseEntry) throw new Error("Missing course content for coding-bootcamp-in-a-box");
---

<BaseLayout title={homepageCopy.seo.title} description={homepageCopy.seo.description}>
  <section class="home-hero" aria-labelledby="home-heading">
    <div class="wrap">
      <h1 id="home-heading" class="display-xl">
        {homepageCopy.hero.heading[0]}<br />{homepageCopy.hero.heading[1]}
      </h1>
      <p class="home-hero-intro">{homepageCopy.hero.intro}</p>
      <p class="lede">{homepageCopy.hero.lede}</p>
      <NewsletterForm
        placement="homepage-hero"
        variant="inline"
        heading=""
        copy=""
        buttonLabel={homepageCopy.hero.joinLabel}
        note={homepageCopy.hero.note}
      />
      {latest && <p class="home-hero-link">
        <a
          href={`/insights/${latest.slug}`}
          data-analytics-cta="latest-edition"
          data-analytics-placement="homepage-hero"
          data-analytics-content-slug={latest.slug}
        >{homepageCopy.hero.latestLabel}</a>
      </p>}
    </div>
  </section>

  <section class="section" aria-labelledby="edition-heading">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{homepageCopy.edition.eyebrow}</p>
        <h2 id="edition-heading" class="display-lg">
          {homepageCopy.edition.heading[0]}<br />{homepageCopy.edition.heading[1]}
        </h2>
        <p class="lede">{homepageCopy.edition.lede}</p>
      </div>
      <div class="grid-4">
        {homepageCopy.edition.beats.map((beat) => (
          <article class:list={["panel", beat.label && "method-build"]}>
            <div class="panel-head"><Icon name={beat.icon} /><p class="meta">{beat.number}</p></div>
            <h3>{beat.title}</h3>
            <p>{beat.body}</p>
            {beat.label && <span class="lime-label">{beat.label}</span>}
          </article>
        ))}
      </div>
      <div class="extensions">
        <div class="extensions-head">
          <p class="meta">{homepageCopy.edition.extensionsLabel}</p>
          <p>{homepageCopy.edition.extensionsNote}</p>
        </div>
        <ul class="extension-list">
          {homepageCopy.edition.extensions.map((block) => (
            <li>
              <div class="panel-head"><Icon name={block.icon} /><p class="meta">{block.number}</p></div>
              <b>{block.title}</b>
              <p>{block.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section section-cloud" aria-labelledby="latest-heading">
    <div class="wrap">
      <p class="eyebrow">{homepageCopy.latest.eyebrow}</p>
      <div class:list={["home-latest", previous.length > 0 && "home-grid-2"]}>
        <div>
          {latest ? <>
            {(latestTags.stages.length > 0 || latestTags.topics.length > 0) && (
              <div class="tag-row" aria-label="Edition topics">
                {latestTags.stages.map((stage) => <StageTag stage={stage} />)}
                {latestTags.topics.map((topic) => <span class="tag">{topic}</span>)}
              </div>
            )}
            <h2 id="latest-heading" class="display-lg">{latest.title}</h2>
            <p class="lede">{latest.excerpt}</p>
            <p class="meta home-edition-meta">{date} · {latest.author}</p>
            <a class="button button-secondary" href={`/insights/${latest.slug}`}>
              {homepageCopy.latest.readLabel}
            </a>
          </> : <>
            <h2 id="latest-heading" class="display-lg">{editionEmptyState.heading}</h2>
            <p class="lede">{editionEmptyState.body}</p>
          </>}
        </div>
        {previous.length > 0 && (
          <div class="latest-aside">
            <p class="meta">{homepageCopy.latest.previousLabel}</p>
            <ol>
              {previous.map((edition, index) => (
                <li>
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <a href={`/insights/${edition.slug}`}>{edition.title}<small>{formatEditionDate(edition.publishedAt)}</small></a>
                </li>
              ))}
            </ol>
            <a href="/insights">{homepageCopy.latest.browseLabel}</a>
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="course-heading">
    <div class="wrap">
      <p class="eyebrow">{homepageCopy.featuredLearning.eyebrow}</p>
      <div class="home-grid-2 featured-learning">
        <div>
          <h2 id="course-heading" class="display-lg">
            {homepageCopy.featuredLearning.heading[0]}<br />
            {homepageCopy.featuredLearning.heading[1]}
          </h2>
          <p class="lede">{homepageCopy.featuredLearning.lede}</p>
          <div class="compatibility">
            {courseEntry.data.compatibility.map((agent) => (
              <span data-status={agent.status}>{agent.name} · {agent.status}</span>
            ))}
          </div>
          <a
            class="button button-dark"
            href="/learning/coding-bootcamp-in-a-box"
            data-analytics-cta="featured-course"
            data-analytics-placement="homepage"
          >{homepageCopy.featuredLearning.ctaLabel}</a>
        </div>
        <dl class="course-facts" aria-label="Course details">
          <div><dt>Lessons</dt><dd>{courseStats.lessonCount}</dd></div>
          <div><dt>Phases</dt><dd>{courseStats.phaseCount}</dd></div>
          <div><dt>Course time</dt><dd>{courseHours} hours</dd></div>
          <div><dt>Objectives</dt><dd>{courseStats.objectiveCount}</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section section-cloud" aria-labelledby="audience-heading">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{homepageCopy.audience.eyebrow}</p>
        <h2 id="audience-heading" class="display-lg">
          {homepageCopy.audience.heading[0]}<br />{homepageCopy.audience.heading[1]}
        </h2>
        <p class="lede">{homepageCopy.audience.lede}</p>
      </div>
      <div class="grid-3">
        {homepageCopy.audience.groups.map((group) => (
          <article class="panel">
            <StageTag stage={group.stage} />
            <h3>{group.title}</h3>
            <p>{group.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-ink" aria-labelledby="founder-heading">
    <div class="wrap">
      <p class="eyebrow">{homepageCopy.founder.eyebrow}</p>
      <div class="home-grid-2 founder-grid">
        <h2 id="founder-heading" class="display-lg">
          {homepageCopy.founder.heading.join(" ")}
        </h2>
        <div>
          {homepageCopy.founder.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          <a href="/about">{homepageCopy.founder.ctaLabel}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section mission-section" aria-labelledby="mission-heading">
    <div class="wrap">
      <div class="mission-copy">
        <p class="eyebrow">{homepageCopy.mission.eyebrow}</p>
        <h2 id="mission-heading" class="display-lg">{homepageCopy.mission.heading}</h2>
        <p class="lede">{homepageCopy.mission.lede}</p>
      </div>
    </div>
  </section>

  <section id="join" class="section section-cloud final-signup" aria-labelledby="join-heading">
    <div class="wrap">
      <h2 id="join-heading" class="display-lg">
        {homepageCopy.finalSignup.heading[0]}<br />{homepageCopy.finalSignup.heading[1]}
      </h2>
      <NewsletterForm
        placement="homepage-final"
        variant="inline"
        heading=""
        copy=""
        buttonLabel={homepageCopy.finalSignup.buttonLabel}
        note={homepageCopy.finalSignup.note}
      />
    </div>
  </section>
</BaseLayout>
