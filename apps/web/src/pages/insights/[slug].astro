---
export const prerender = false;

import Authors from "../../components/Authors.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { articleSchema, insightPath, temporarilyUnavailable } from "../../lib/seo";
import ArticleEnd from "../../components/ArticleEnd.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NewsletterForm from "../../components/NewsletterForm.astro";
import { getInsightBySlug, listAllPublishedInsights, type InsightSummary } from "../../lib/insights";
import { formatEditionDate } from "../../lib/tags";

const slug = Astro.params.slug ?? "";
let post;
try {
  post = await getInsightBySlug(Astro.locals, slug);
} catch {
  return temporarilyUnavailable();
}

if (!post) {
  const response = await Astro.rewrite("/404");
  return new Response(response.body, { status: 404, headers: response.headers });
}

// Neighbours in the archive for previous / next. Listing failures degrade to
// no navigation rather than a failed page.
let previous: InsightSummary | null = null;
let next: InsightSummary | null = null;
try {
  const editions = await listAllPublishedInsights(Astro.locals);
  const index = editions.findIndex((edition) => edition.slug === post.slug);
  if (index >= 0) {
    previous = editions[index + 1] ?? null;
    next = editions[index - 1] ?? null;
  }
} catch {
  // Leave navigation empty.
}

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=300, stale-while-revalidate=86400, stale-if-error=604800",
);

const date = formatEditionDate(post.publishedAt, "long");
const canonical = insightPath(post.slug);
---

<BaseLayout
  title={post.title}
  description={post.excerpt}
  canonicalPath={canonical}
  ogType="article"
  ogImage={post.image}
  publishedAt={post.publishedAt}
  structuredData={articleSchema(post)}
>
  <article>
    <header class="article-header">
      <div class="narrow">
        <Breadcrumbs items={[{ name: "Home", path: "/" }, { name: "Insights", path: "/insights" }, { name: post.title, path: canonical }]} />
        <p class="eyebrow">Insight</p>
        <h1>{post.title}</h1>
        <p class="article-dek">{post.excerpt}</p>
        <p class="meta"><Authors authors={post.authors} /> · {date} · {post.readingMinutes} min read</p>
      </div>
    </header>
    {post.image && (
      <div class="wrap article-image-wrap">
        <img class="article-image" src={post.image} alt="" width="1200" height="630" />
      </div>
    )}
    <div class="article-body" set:html={post.html} />
    <ArticleEnd post={post} previous={previous} next={next} />
  </article>

  <section class="section build-focus">
    <div class="wrap">
      <NewsletterForm placement="insight-footer" />
    </div>
  </section>
</BaseLayout>
