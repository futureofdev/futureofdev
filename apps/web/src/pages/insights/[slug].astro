---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import NewsletterForm from "../../components/NewsletterForm.astro";
import { getInsightBySlug } from "../../lib/insights";

const slug = Astro.params.slug ?? "";
let post;
try {
  post = await getInsightBySlug(Astro.locals, slug);
} catch {
  return new Response("This edition is temporarily unavailable.", {
    status: 503,
    headers: {
      "Content-Type": "text/plain; charset=utf-8",
      "Cache-Control": "public, max-age=0, stale-if-error=604800",
      "Retry-After": "60",
    },
  });
}

if (!post) return Astro.redirect("/404", 302);

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=300, stale-while-revalidate=86400, stale-if-error=604800",
);

const date = new Date(post.publishedAt).toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
const canonical = `/insights/${post.slug}`;
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.title,
  description: post.excerpt,
  datePublished: post.publishedAt,
  mainEntityOfPage: `https://futureofdev.com${canonical}`,
  author: { "@type": "Person", name: post.author },
  publisher: {
    "@type": "Organization",
    name: "Future of Dev",
    logo: { "@type": "ImageObject", url: "https://futureofdev.com/brand/fod-symbol.svg" },
  },
  ...(post.image ? { image: post.image } : {}),
};
---

<BaseLayout
  title={post.title}
  description={post.excerpt}
  canonicalPath={canonical}
  ogType="article"
  ogImage={post.image}
  publishedAt={post.publishedAt}
  structuredData={articleSchema}
>
  <article>
    <header class="article-header">
      <div class="narrow">
        <p class="eyebrow">Insight</p>
        <h1>{post.title}</h1>
        <p class="article-dek">{post.excerpt}</p>
        <p class="meta">{post.author} · {date} · {post.readingMinutes} min read</p>
      </div>
    </header>
    {post.image && (
      <div class="wrap article-image-wrap">
        <img class="article-image" src={post.image} alt="" width="1200" height="630" />
      </div>
    )}
    <div class="article-body" set:html={post.html} />
  </article>

  <section class="section build-focus">
    <div class="wrap">
      <NewsletterForm placement="insight-footer" />
    </div>
  </section>
</BaseLayout>
