---
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";

const status = Astro.url.searchParams.get("status");
Astro.response.headers.set("Cache-Control", "private, no-store");
---

<BaseLayout title="Email preferences" description="Manage your Future of Dev subscription." noindex>
  <section class="prose-page narrow">
    {status === "success" ? (
      <>
        <p class="eyebrow">All done</p>
        <h1>You have been unsubscribed.</h1>
        <p class="lede">Beehiiv will no longer send Future of Dev to this address.</p>
        <p><a class="button" href="/">Return home</a></p>
      </>
    ) : status === "invalid" ? (
      <>
        <p class="eyebrow">Invalid link</p>
        <h1>That link was not recognised.</h1>
        <p>Email <a href="mailto:luke@futureofdev.com">luke@futureofdev.com</a> for help.</p>
      </>
    ) : status === "error" ? (
      <>
        <p class="eyebrow">Temporary error</p>
        <h1>Your preferences could not be updated.</h1>
        <p>Please try again or email <a href="mailto:luke@futureofdev.com">luke@futureofdev.com</a>.</p>
      </>
    ) : status === "confirm" ? (
      <>
        <p class="eyebrow">Legacy email link</p>
        <h1>Unsubscribe from Future of Dev?</h1>
        <p class="lede">This will update your subscription in Beehiiv. New editions use Beehiiv’s own preference links.</p>
        <form method="post" action="/api/unsubscribe" class="ph-no-capture" data-ph-no-capture>
          <button class="button" type="submit">Confirm unsubscribe</button>
        </form>
      </>
    ) : (
      <>
        <p class="eyebrow">Email preferences</p>
        <h1>Use the link in your latest edition.</h1>
        <p>Beehiiv’s preference and unsubscribe links appear in the footer of every newsletter.</p>
      </>
    )}
  </section>
</BaseLayout>
