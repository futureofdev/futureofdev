---
import LandingLayout from "../layouts/LandingLayout.astro";

export const prerender = false;

const status = Astro.url.searchParams.get("status");
---

<LandingLayout title="Unsubscribe" description="Manage your email preferences.">
  <div class="min-h-[60vh] flex items-center justify-center px-6">
    <div class="max-w-sm w-full text-center">
      {status === "success" && (
        <div>
          <p class="text-xs font-mono uppercase tracking-widest text-muted-foreground mb-3">All done</p>
          <h1 class="text-2xl font-bold mb-3">You've been unsubscribed</h1>
          <p class="text-muted-foreground text-sm leading-relaxed mb-8">
            You won't receive any more emails from Future of Dev. Changed your mind?
          </p>
          <a
            href="/"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-primary text-primary-foreground font-medium hover:bg-primary/90 transition-colors text-sm"
          >
            Back to Future of Dev
          </a>
        </div>
      )}

      {status === "invalid" && (
        <div>
          <p class="text-xs font-mono uppercase tracking-widest text-muted-foreground mb-3">Invalid link</p>
          <h1 class="text-2xl font-bold mb-3">Link not recognised</h1>
          <p class="text-muted-foreground text-sm leading-relaxed mb-8">
            This unsubscribe link is invalid or has expired. Email us at
            <a href="mailto:luke@futureofdev.com" class="underline underline-offset-2 hover:text-foreground transition-colors">luke@futureofdev.com</a>
            and we'll remove you manually.
          </p>
        </div>
      )}

      {(status === "error" || !status) && (
        <div>
          <p class="text-xs font-mono uppercase tracking-widest text-muted-foreground mb-3">Something went wrong</p>
          <h1 class="text-2xl font-bold mb-3">Couldn't unsubscribe</h1>
          <p class="text-muted-foreground text-sm leading-relaxed mb-8">
            Please email us at
            <a href="mailto:luke@futureofdev.com" class="underline underline-offset-2 hover:text-foreground transition-colors">luke@futureofdev.com</a>
            and we'll take care of it.
          </p>
        </div>
      )}
    </div>
  </div>
</LandingLayout>
