---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="The requested Future of Dev page was not found." noindex>
  <section class="hero">
    <div class="narrow">
      <p class="eyebrow">404</p>
      <h1 class="display-xl">That path ends here.</h1>
      <p class="lede">The page may have moved, or the address may be incomplete.</p>
      <p><a class="button" href="/">Go home</a> <a class="button button-secondary" href="/insights">Read insights</a></p>
    </div>
  </section>
</BaseLayout>
