---
import LandingLayout from "../../layouts/LandingLayout.astro";
import { PortableTextContent } from "../../components/PortableTextContent";
import AnimatedClawd from "../../components/AnimatedClawd.astro";
import { sanityClient, allCoursesQuery, courseBySlugQuery } from "@futureofdev/sanity-client";

export async function getStaticPaths() {
  let courses: any[] = [];
  try {
    courses = await sanityClient.fetch(allCoursesQuery);
  } catch (e) {
    console.log("Could not fetch courses for static paths");
    return [];
  }
  return courses.map((course: any) => ({
    params: { slug: course.slug.current },
  }));
}

const { slug } = Astro.params;

let course: any = null;
try {
  course = await sanityClient.fetch(courseBySlugQuery, { slug });
} catch (e) {
  console.log("Could not fetch course");
}

if (!course) {
  return Astro.redirect("/claude-academy");
}

const attachments: any[] = course.attachments ?? [];
const hasAttachments = attachments.length > 0;

// Extract headings from body for outline
type OutlineItem = { text: string; level: "h2" | "h3" };
const outline: OutlineItem[] = (course.body ?? [])
  .filter((block: any) => block._type === "block" && (block.style === "h2" || block.style === "h3"))
  .map((block: any) => ({
    text: block.children?.map((c: any) => c.text).join("") ?? "",
    level: block.style as "h2" | "h3",
  }))
  .filter((item: OutlineItem) => item.text.length > 0);
const hasOutline = outline.length > 0;

function formatFileSize(bytes: number): string {
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(0)} KB`;
  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
}
---

<LandingLayout
  title={`${course.title} — Claude Academy`}
  description={course.description ?? `${course.title} — a free course on Claude Academy.`}
  favicon="/claude-academy.svg"
>
  <!-- Back Navigation -->
  <nav class="fixed top-4 left-4 z-40">
    <a
      href="/claude-academy"
      class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground transition-colors font-mono p-2 -m-2"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      <span class="hidden sm:inline">Claude Academy</span>
    </a>
  </nav>

  <div class="max-w-2xl mx-auto px-6 pt-16 md:pt-24">

    <!-- Hero -->
    <div class="pb-8">
      <!-- Label row -->
      <div class="flex items-center gap-2 mb-4">
        <AnimatedClawd class="w-8 h-8 flex-shrink-0" />
        <span class="text-xs font-mono uppercase tracking-widest text-primary">{course.title}</span>
      </div>

      <!-- Title -->
      <h1 class="text-3xl md:text-[2.625rem] font-bold tracking-tight leading-[1.15] mb-4">
        {course.tagline ?? course.title}
      </h1>

      <!-- Badges -->
      {(course.level || (course.tags ?? []).length > 0) && (
        <div class="flex items-center gap-2 flex-wrap mb-4">
          {course.level && (
            <span class="inline-flex items-center px-2.5 py-1 text-[10px] font-mono font-semibold uppercase tracking-wider bg-primary/10 text-primary rounded-full">
              {course.level}
            </span>
          )}
          {(course.tags ?? []).map((tag: string) => (
            <span class="inline-flex items-center px-2.5 py-1 text-[10px] font-mono uppercase tracking-wider border border-border text-muted-foreground rounded-full">
              {tag}
            </span>
          ))}
        </div>
      )}

      <!-- Description -->
      {course.description && (
        <p class="text-base md:text-lg text-muted-foreground leading-relaxed max-w-prose">
          {course.description}
        </p>
      )}
    </div>

    <!-- Divider -->
    <hr class="border-border" />

    {course.comingSoon ? (
      <!-- Coming Soon: subscription form -->
      <div class="pt-8 pb-16">
        <p class="text-xs font-mono uppercase tracking-widest text-muted-foreground mb-2">Coming Soon</p>
        <h2 class="text-xl font-semibold mb-2">This course is in development</h2>
        <p class="text-muted-foreground text-sm leading-relaxed mb-8">
          We're working on it. Drop your email and we'll let you know the moment it's ready.
        </p>
        <form id="notify-form" class="flex gap-3 max-w-sm">
          <input
            type="email"
            name="email"
            required
            placeholder="you@example.com"
            class="flex-1 px-4 py-2.5 rounded-lg border border-border bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-colors text-sm"
          />
          <button
            type="submit"
            class="px-5 py-2.5 rounded-lg bg-primary text-primary-foreground font-medium hover:bg-primary/90 transition-colors whitespace-nowrap text-sm"
          >
            Notify me
          </button>
        </form>
        <p id="notify-message" class="mt-3 text-sm hidden"></p>
      </div>
    ) : (
      <!-- Live course: outline + material + body -->
      <div>
        {hasOutline && (
          <div class="pt-8 pb-8">
            <p class="text-xs font-mono uppercase tracking-widest text-muted-foreground mb-4">In this course</p>
            <ol class="space-y-2">
              {outline.map((item, i) => (
                <li class={`flex items-baseline gap-3 ${item.level === "h3" ? "pl-4" : ""}`}>
                  <span class="text-xs font-mono text-muted-foreground/50 flex-shrink-0 w-5 text-right">
                    {(i + 1).toString().padStart(2, "0")}
                  </span>
                  <span class={`text-sm ${item.level === "h2" ? "text-foreground font-medium" : "text-muted-foreground"}`}>
                    {item.text}
                  </span>
                </li>
              ))}
            </ol>
          </div>
        )}

        {hasAttachments && (
          <div class="pb-8">
            <p class="text-xs font-mono uppercase tracking-widest text-muted-foreground mb-3">Course Material</p>
            <ul class="space-y-2">
              {attachments.map((attachment: any) => {
                const url = attachment.file?.asset?.url;
                const filename = attachment.file?.asset?.originalFilename ?? attachment.label;
                const size = attachment.file?.asset?.size;
                return url ? (
                  <li>
                    <a
                      href={url}
                      download={filename}
                      class="flex items-center gap-3 group py-3 px-4 rounded-lg border border-border hover:border-primary/40 hover:bg-muted/30 transition-all"
                    >
                      <span class="flex-shrink-0 w-8 h-8 rounded-md bg-muted flex items-center justify-center text-muted-foreground group-hover:text-primary transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                      </span>
                      <div class="flex-1 min-w-0">
                        <p class="text-sm font-medium text-foreground group-hover:text-primary transition-colors">
                          {attachment.label}
                        </p>
                        {size && (
                          <p class="text-xs text-muted-foreground">{formatFileSize(size)}</p>
                        )}
                      </div>
                      <svg class="w-4 h-4 text-muted-foreground group-hover:text-primary transition-colors flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                      </svg>
                    </a>
                  </li>
                ) : null;
              })}
            </ul>
          </div>
        )}

        {course.body && course.body.length > 0 && (
          <div class="pb-16 course-prose">
            <PortableTextContent value={course.body} client:load />
          </div>
        )}
      </div>
    )}
  </div>

  <!-- Newsletter -->
  <section class="border-t border-border">
    <div class="max-w-2xl mx-auto px-6 py-16 text-center">
      <p class="text-xs font-mono uppercase tracking-widest text-muted-foreground mb-3">Stay in the loop</p>
      <h2 class="text-xl font-semibold mb-2">Free courses, insights & news</h2>
      <p class="text-sm text-muted-foreground mb-6 max-w-sm mx-auto">
        Get notified when new courses drop and receive our best content on agentic development — straight to your inbox.
      </p>
      <form id="newsletter-form" class="flex flex-col sm:flex-row gap-3 max-w-sm mx-auto">
        <input
          type="email"
          name="email"
          required
          placeholder="you@example.com"
          class="flex-1 px-4 py-2.5 rounded-lg border border-border bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition-colors text-sm"
        />
        <button
          type="submit"
          class="px-5 py-2.5 rounded-lg bg-primary text-primary-foreground font-medium hover:bg-primary/90 transition-colors whitespace-nowrap text-sm"
        >
          Subscribe
        </button>
      </form>
      <p id="newsletter-message" class="mt-3 text-sm hidden"></p>
    </div>
  </section>

  <!-- Footer -->
  <div slot="footer">
    <div class="flex justify-center gap-6 text-muted-foreground">
      <a href="https://linkedin.com/company/futureofdev" target="_blank" rel="noopener noreferrer" class="hover:text-foreground transition-colors" aria-label="LinkedIn">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>
      <a href="mailto:luke@futureofdev.com" class="hover:text-foreground transition-colors" aria-label="Email">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0l-9.75 6.093L2.25 6.75" />
        </svg>
      </a>
    </div>
  </div>
</LandingLayout>

<script>
  function setupForm(formId: string, buttonLabel: string, successMessage: string) {
    const form = document.getElementById(formId) as HTMLFormElement | null;
    const message = document.getElementById(`${formId.replace("-form", "-message")}`) as HTMLElement | null;

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const email = new FormData(form).get("email") as string;
      const button = form.querySelector("button") as HTMLButtonElement;

      button.disabled = true;
      button.textContent = "Sending...";
      message?.classList.add("hidden");

      try {
        const res = await fetch("/api/newsletter", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email }),
        });
        const data = await res.json();
        if (res.ok) {
          message!.textContent = successMessage;
          message!.className = "mt-3 text-sm text-primary";
          form.reset();
        } else {
          message!.textContent = data.error || "Something went wrong. Try again.";
          message!.className = "mt-3 text-sm text-red-500";
        }
      } catch {
        message!.textContent = "Network error. Please try again.";
        message!.className = "mt-3 text-sm text-red-500";
      } finally {
        button.disabled = false;
        button.textContent = buttonLabel;
      }
    });
  }

  setupForm("notify-form", "Notify me", "You're on the list — we'll email you when this launches.");
  setupForm("newsletter-form", "Subscribe", "Thanks for subscribing — welcome to the community!");
</script>

<style>
  /* Tighter prose spacing for course content */
  .course-prose :global(p) {
    margin-bottom: 1.5rem;
    line-height: 1.75;
    color: hsl(var(--foreground) / 0.85);
  }
  .course-prose :global(h2) {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 2.75rem;
    margin-bottom: 1rem;
    color: hsl(var(--foreground));
    letter-spacing: -0.01em;
  }
  .course-prose :global(*:first-child) {
    margin-top: 0;
  }
  .course-prose :global(h3) {
    font-size: 1.1rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: hsl(var(--foreground));
  }
</style>
