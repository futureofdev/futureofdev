---
export const prerender = false;

import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Icon from "../../components/Icon.astro";
import NewsletterForm from "../../components/NewsletterForm.astro";
import { courseStats, courseHours } from "../../lib/course-content";

const courses = (await getCollection("courses")).sort((a, b) =>
  Number(b.data.featured) - Number(a.data.featured),
);
---

<BaseLayout
  title="Practical Courses and AI Learning"
  description="Explore practical learning from Future of Dev. Start with Coding Bootcamp in a Box, a free self-paced course for building your web development skills."
>
  <header class="hero">
    <div class="wrap">
      <Breadcrumbs items={[{ name: "Home", path: "/" }, { name: "Learn", path: "/learning" }]} />
      <p class="eyebrow">Learn</p>
      <h1 class="display-xl">Learn by building.</h1>
      <p class="lede">Develop a skill through work you can make, explain and improve. Start with Coding Bootcamp in a Box, our self-paced introduction to web development.</p>
    </div>
  </header>

  <section class="section section-cloud" aria-labelledby="courses-heading">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Courses</p>
        <h2 id="courses-heading" class="display-lg">Start with the coding course.</h2>
        <p class="lede">
          Download the course materials and keep them on your computer. The course page explains
          what you will build, which tools you need and how to begin.
        </p>
      </div>
      <div class="course-list">
        {courses.map((course) => (
          <article class="course-card">
            <div class="course-card-body">
              <p class="eyebrow">{course.data.eyebrow}</p>
              <h3 class="display-md">{course.data.headline}</h3>
              <p class="lede">{course.data.summary}</p>
              <div class="compatibility">
                {course.data.compatibility.map((agent) => (
                  <span data-status={agent.status}>{agent.name} · {agent.status}</span>
                ))}
              </div>
              <a class="button button-build" href={`/learning/${course.data.slug}`} data-analytics-cta="view-course" data-analytics-placement="learning-index" data-analytics-content-slug={course.data.slug}>View the course</a>
            </div>
            <div class="course-card-aside">
              <p class="meta">At a glance</p>
              <dl class="stat-list">
                <div><dt>Lessons</dt><dd>{courseStats.lessonCount}</dd></div>
                <div><dt>Phases</dt><dd>{courseStats.phaseCount}</dd></div>
                <div><dt>Course time</dt><dd>{courseHours}h</dd></div>
                <div><dt>Objectives</dt><dd>{courseStats.objectiveCount}</dd></div>
              </dl>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="how-heading">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">How courses work</p>
        <h2 id="how-heading" class="display-lg">Your tutor guides. You do the work.</h2>
      </div>
      <div class="grid-3">
        <article class="panel"><div class="panel-head"><Icon name="issue-03-learn" /><p class="meta">Learn</p></div><h3>Understand the why</h3><p>Short explanations, checks and analogies build a working mental model.</p></article>
        <article class="panel"><div class="panel-head"><Icon name="lifecycle-build" /><p class="meta">Build</p></div><h3>Put it into practice</h3><p>Every phase moves a real project forward instead of ending at passive recall.</p></article>
        <article class="panel"><div class="panel-head"><Icon name="lifecycle-test" /><p class="meta">Demonstrate</p></div><h3>Show the evidence</h3><p>Homework checks what runs, what you understand and what you can explain.</p></article>
      </div>
    </div>
  </section>

  <section class="section build-focus">
    <div class="wrap"><NewsletterForm placement="learning-footer" heading="Get new courses and exercises by email." /></div>
  </section>
</BaseLayout>
