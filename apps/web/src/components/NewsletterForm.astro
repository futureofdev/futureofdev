---
interface Props {
  placement: string;
  offer?: string;
  heading?: string;
  copy?: string;
  buttonLabel?: string;
  downloadLabel?: string;
  note?: string;
  variant?: "card" | "inline";
}

const {
  placement,
  offer,
  heading = "One useful edition. Every week.",
  copy = "Understand what is changing, learn a practical skill and build something real. No noise, and you can unsubscribe at any time.",
  buttonLabel = offer ? "Subscribe and get the course" : "Join the newsletter",
  downloadLabel = "Download the course",
  note = "By subscribing you agree to receive Future of Dev by email. Analytics consent is separate.",
  variant = "card",
} = Astro.props;
---

<div class:list={["newsletter-block", { "newsletter-inline": variant === "inline" }]}>
  {heading && <h2>{heading}</h2>}
  {copy && <p>{copy}</p>}
  <form
    class="newsletter-form ph-no-capture"
    data-placement={placement}
    data-offer={offer}
    data-download-label={downloadLabel}
    data-ph-no-capture
  >
    <div class="newsletter-form-fields">
      <label class="sr-only" for={`newsletter-${placement}`}>Email address</label>
      <input
        id={`newsletter-${placement}`}
        type="email"
        name="email"
        inputmode="email"
        autocomplete="email"
        maxlength="254"
        placeholder="you@work.com"
        aria-describedby={`newsletter-note-${placement}`}
        data-ph-no-capture
        required
      />
      <button class="button" type="submit">{buttonLabel}</button>
    </div>
    <p id={`newsletter-note-${placement}`} class="form-note">
      {note}
    </p>
    <p class="form-message" role="status" aria-live="polite" hidden></p>
    <p class="download-link" hidden><a class="button button-secondary" href="#">{downloadLabel}</a></p>
  </form>
</div>

<script>
  import { captureAnalyticsEvent, identifySubscriber } from "../lib/analytics";
  import type { NewsletterResponse } from "../types/api";

  const EMAIL_FREE_PATH = `${window.location.origin}${window.location.pathname}`;
  const ATTRIBUTION_KEYS = ["utm_source", "utm_medium", "utm_campaign", "utm_term", "utm_content"] as const;

  function bounded(value: string | null, max = 100) {
    return value?.trim().slice(0, max) || undefined;
  }

  document.querySelectorAll<HTMLFormElement>(".newsletter-form").forEach((form) => {
    if (form.dataset.bound === "true") return;
    form.dataset.bound = "true";

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const message = form.querySelector<HTMLElement>(".form-message");
      const download = form.querySelector<HTMLElement>(".download-link");
      const downloadAnchor = download?.querySelector<HTMLAnchorElement>("a");
      const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
      const email = new FormData(form).get("email");
      if (typeof email !== "string" || !button || !message) return;

      const originalLabel = button.textContent || "Join the newsletter";
      button.disabled = true;
      button.textContent = "Joining…";
      message.hidden = true;
      if (download) download.hidden = true;

      const params = new URLSearchParams(window.location.search);
      const attribution = Object.fromEntries(
        ATTRIBUTION_KEYS.map((key) => [key, bounded(params.get(key))]).filter(([, value]) => value),
      );
      const analyticsConsent = localStorage.getItem("ph_consent") === "true";
      const offer = form.dataset.offer || "newsletter";

      captureAnalyticsEvent("newsletter_signup_started", {
        placement: form.dataset.placement || "unknown",
        offer,
      });

      try {
        const response = await fetch("/api/newsletter", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            email,
            placement: form.dataset.placement,
            offer: form.dataset.offer || undefined,
            pageUrl: EMAIL_FREE_PATH,
            attribution,
            analyticsConsent,
          }),
        });
        const result = await response.json() as NewsletterResponse;

        if (!response.ok || !result.success) {
          throw new Error("error" in result ? result.error : "Unable to subscribe right now.");
        }

        if (analyticsConsent && result.analyticsId) {
          identifySubscriber(result.analyticsId);
          captureAnalyticsEvent("newsletter_subscribed", {
            placement: form.dataset.placement || "unknown",
            offer,
            already_subscribed: Boolean(result.alreadySubscribed),
          });
        }

        message.textContent = result.downloadUrl
          ? result.alreadySubscribed
            ? "Welcome back. Your course is ready to download now."
            : "You’re subscribed. Your course is ready to download now."
          : result.alreadySubscribed
            ? "You’re already on the list. Welcome back."
            : "You’re in. Look out for the next weekly edition.";
        message.dataset.state = "success";
        message.hidden = false;
        form.reset();

        if (result.downloadUrl && download && downloadAnchor) {
          downloadAnchor.href = result.downloadUrl;
          downloadAnchor.textContent = form.dataset.downloadLabel || "Download the course";
          download.hidden = false;
        }
      } catch (error) {
        message.textContent = error instanceof Error ? error.message : "Unable to subscribe right now.";
        message.dataset.state = "error";
        message.hidden = false;
        if (analyticsConsent) {
          captureAnalyticsEvent("newsletter_subscription_failed", {
            placement: form.dataset.placement || "unknown",
            offer,
          });
        }
      } finally {
        button.disabled = false;
        button.textContent = originalLabel;
      }
    });

    form.querySelector<HTMLAnchorElement>(".download-link a")?.addEventListener("click", () => {
      captureAnalyticsEvent("course_download_requested", {
        course: form.dataset.offer || "unknown",
        placement: form.dataset.placement || "unknown",
      });
    });
  });
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
