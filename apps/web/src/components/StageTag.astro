---
/**
 * Career-stage label.
 *
 * Brand rule: a career-stage label always pairs an icon *and* a word, never
 * colour alone. The icon is inlined so it inherits `currentColor` from the tag.
 */
interface Props {
  stage: "evolve" | "enter" | "lead" | "everyone";
  class?: string;
}

const { stage, class: className } = Astro.props;

const labels = {
  evolve: "Evolve",
  enter: "Enter",
  lead: "Lead",
  everyone: "Everyone",
} as const;
---

<span class:list={["tag", `tag-${stage}`, className]}>
  <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="butt" stroke-linejoin="miter" aria-hidden="true" focusable="false">
    {stage === "evolve" && (
      <>
        <rect x="3" y="15" width="5" height="6" fill="currentColor" stroke="none" />
        <rect x="9.5" y="10" width="5" height="11" fill="currentColor" stroke="none" />
        <rect x="16" y="5" width="5" height="16" fill="currentColor" stroke="none" />
      </>
    )}
    {stage === "enter" && (
      <>
        <path d="M13 3H21V21H13" />
        <path d="M3 12H15" />
        <path d="M11 8L15 12L11 16" />
      </>
    )}
    {stage === "lead" && (
      <>
        <path d="M5 21V3" />
        <path d="M5 3H19L15.5 8L19 13H5" />
      </>
    )}
    {stage === "everyone" && (
      <>
        <circle cx="8" cy="9" r="3" />
        <circle cx="16" cy="9" r="3" />
        <path d="M3 20V18C3 16 5 15 8 15C11 15 13 16 13 18V20" />
        <path d="M13 20V18C13 16.5 15 15 18 15C20 15 21 16.5 21 18V20" />
      </>
    )}
  </svg>
  {labels[stage]}
</span>
