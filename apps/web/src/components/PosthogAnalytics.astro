<script>
  import {
    captureAnalyticsEvent,
    denyAnalytics,
    initialiseAnalytics,
  } from "../lib/analytics";

  const key = import.meta.env.PUBLIC_POSTHOG_KEY as string | undefined;
  const host = (import.meta.env.PUBLIC_POSTHOG_HOST as string | undefined) || "https://eu.i.posthog.com";

  function initialisePostHog() {
    initialiseAnalytics(key, host);
  }

  initialisePostHog();
  window.addEventListener("ph:consent-granted", initialisePostHog);
  window.addEventListener("ph:consent-denied", denyAnalytics);

  document.addEventListener("click", (event) => {
    const target = event.target instanceof Element
      ? event.target.closest<HTMLElement>("[data-analytics-cta]")
      : null;
    if (!target) return;
    captureAnalyticsEvent("cta_clicked", {
      cta: target.dataset.analyticsCta || "unknown",
      ...(target.dataset.analyticsPlacement
        ? { placement: target.dataset.analyticsPlacement }
        : {}),
      ...(target.dataset.analyticsContentSlug
        ? { content_slug: target.dataset.analyticsContentSlug }
        : {}),
    });
  });
</script>
