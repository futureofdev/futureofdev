---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  fill="none"
  viewBox="0 0 128 128"
  class={className}
>
  <rect width="128" height="128" rx="24" fill="#1a1a2e" />
  <!-- Terminal code lines -->
  <path
    d="M28 80h72M28 96h52"
    stroke="#fff"
    stroke-width="6"
    stroke-linecap="round"
    opacity="0.3"
  />
  <!-- Graduation cap -->
  <polygon
    points="64,28 28,48 64,68 100,48"
    fill="none"
    stroke="#fff"
    stroke-width="5"
    stroke-linejoin="round"
  />
  <polyline
    points="44,56 44,76 64,88 84,76 84,56"
    fill="none"
    stroke="#fff"
    stroke-width="5"
    stroke-linejoin="round"
  />
  <line
    x1="100"
    y1="48"
    x2="100"
    y2="72"
    stroke="#fff"
    stroke-width="5"
    stroke-linecap="round"
  />
</svg>
