<div id="cookie-banner" class="cookie-banner" role="dialog" aria-modal="false" aria-labelledby="cookie-title" hidden>
  <p id="cookie-title"><strong>Optional analytics</strong></p>
  <p>
    With your permission, PostHog measures which pages and actions are useful. Newsletter signup works without it.
    <a href="/privacy">Read the privacy notice</a>.
  </p>
  <div class="cookie-actions">
    <button id="cookie-decline" class="button button-secondary" type="button">Decline</button>
    <button id="cookie-accept" class="button" type="button">Allow analytics</button>
  </div>
</div>

<script>
  const banner = document.getElementById("cookie-banner");
  const accept = document.getElementById("cookie-accept");
  const decline = document.getElementById("cookie-decline");

  if (localStorage.getItem("ph_consent") === null) {
    banner?.removeAttribute("hidden");
  }

  accept?.addEventListener("click", () => {
    localStorage.setItem("ph_consent", "true");
    banner?.setAttribute("hidden", "");
    window.dispatchEvent(new Event("ph:consent-granted"));
  });

  decline?.addEventListener("click", () => {
    localStorage.setItem("ph_consent", "false");
    banner?.setAttribute("hidden", "");
    window.dispatchEvent(new Event("ph:consent-denied"));
  });
</script>
